# --- Required ---
# System user access token (see README, "Meta setup"). Never commit this.
META_ACCESS_TOKEN=your-system-user-token
# Your ad account ID, with or without the act_ prefix
META_AD_ACCOUNT_ID=act_1234567890
# Comma-separated campaign IDs the agent may touch, or ALL for the whole ad account
ALLOWED_CAMPAIGN_IDS=ALL

# --- Safety ---
# Anything other than exactly "false" keeps dry-run ON (nothing is paused)
DRY_RUN=true

# --- Optional ---
# Path to a rules file (copy rules.example.yaml). Built-in defaults are used if unset.
# RULES_FILE=./rules.yaml
# Where decisions.jsonl is written. Default: ~/.meta-ads-autopause/logs
# LOG_DIR=./logs
